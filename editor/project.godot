; X4 Galaxy Editor 3D (M.R. Reese). Godot 4.7 .NET project.
config_version=5

[application]

config/name="X4 Galaxy Editor 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

